#!/usr/bin/env python3
"""
Lingua: input language switcher for Omarchy / Hyprland.
- Normal press (single tap): toggles between the last TWO used layouts.
- Rapid presses with the hotkey modifier held (within CYCLE_TIMEOUT_MS): cycles
  through all available layouts. Letting go of the modifier between presses
  makes the next press a plain tap again.
- Works dynamically with ANY layouts configured in Hyprland (zero hardcoding).
"""

import fcntl
import json
import os
import re
import subprocess
import time

STATE_FILE = os.path.expanduser("~/.local/state/lingua-switch.json")
LOCK_FILE = STATE_FILE + ".lock"
SETTINGS_FILE = os.path.expanduser(
    "~/.local/state/omarchy/settings/smyrnode-lingua.json"
)
CYCLE_TIMEOUT_MS = 1000  # 1 second window to continue cycling

# Written by the modifier-press bindings (see write_binding in
# lingua-layout): ms timestamp of the last press of a hotkey modifier.
MODIFIER_FILE = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "lingua-switch.mod"
)
START_MS = int(time.time() * 1000)


def modifier_repressed_since(ts_ms):
    """True if a hotkey modifier was pressed again after `ts_ms`.

    Cycling through all languages needs the modifier held between presses,
    like macOS. Releasing every key between two quick taps starts a new tap
    (toggle the last two). Without the modifier bindings the file never
    exists and only the time window applies.
    """
    try:
        with open(MODIFIER_FILE) as f:
            return int(f.read().strip()) > ts_ms
    except (OSError, ValueError):
        return False


def load_settings():
    try:
        with open(SETTINGS_FILE, "r") as f:
            return json.load(f)
    except Exception:
        return {}


def mru_enabled():
    """True when the recent-language switcher owns the hotkey (vs plain XKB)."""
    return load_settings().get("switchMode", "mru") == "mru"


def get_configured_layouts():
    """Get list of configured layouts from Hyprland options."""
    try:
        out = subprocess.check_output(
            ["hyprctl", "getoption", "input:kb_layout", "-j"],
            stderr=subprocess.DEVNULL,
        )
        data = json.loads(out)
        raw = data.get("str", "")
        layouts = [l.strip() for l in raw.split(",") if l.strip()]
        if layouts:
            return layouts
    except Exception:
        pass
    return ["us"]


def get_configured_variants(count):
    """Per-layout variants from Hyprland options, padded to `count` entries."""
    try:
        out = subprocess.check_output(
            ["hyprctl", "getoption", "input:kb_variant", "-j"],
            stderr=subprocess.DEVNULL,
        )
        raw = json.loads(out).get("str", "")
    except Exception:
        raw = ""
    variants = [v.strip() for v in raw.split(",")]
    return (variants + [""] * count)[:count]


def get_hyprland_devices():
    """Get all connected devices from Hyprland."""
    try:
        out = subprocess.check_output(
            ["hyprctl", "devices", "-j"], stderr=subprocess.DEVNULL
        )
        return json.loads(out)
    except Exception:
        return {}


# Keep in sync with UNTYPED_KEYBOARDS in KeyboardLayoutModel.js and
# untyped_keyboards_re in bin/lingua-layout.
UNTYPED_KEYBOARDS = re.compile(
    r"(consumer|system)-control|avrcp|fcitx|hl-virtual-keyboard|power-button|sleep-button|lid-switch|video-bus"
)


def is_typed_keyboard(name):
    """Filter out non-typing virtual devices, buttons, switches."""
    return not UNTYPED_KEYBOARDS.search(name.lower())


def get_active_layout_index(devices, num_layouts):
    """Active layout index of the typing keyboards.

    Keyboards can disagree (a hot-plugged one starts at index 0), so take the
    furthest along, the same rule the layout helper and the bar widget use.
    """
    keyboards = devices.get("keyboards", [])
    typed = [kb for kb in keyboards if is_typed_keyboard(kb.get("name", ""))]
    indices = [
        kb.get("active_layout_index", 0)
        for kb in (typed or keyboards)
        if isinstance(kb.get("active_layout_index", 0), int)
    ]
    idx = max(indices, default=0)
    return idx if 0 <= idx < num_layouts else 0


def sync_fcitx(layout_code, variant=""):
    """fcitx5 keyboard-* input methods map keysyms themselves, so typing would
    ignore XKB group switches. Keep its input method in step with the layout
    (fcitx5 names variants keyboard-<layout>-<variant>)."""
    name = "keyboard-" + layout_code + ("-" + variant if variant else "")
    try:
        subprocess.run(
            ["fcitx5-remote", "-s", name],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


def apply_layout_to_typed(devices, target_idx, configured_layouts, variants=()):
    """Switch layout on typing keyboards only (skip buttons, consumer/system controls)."""
    keyboards = devices.get("keyboards", [])
    target_str = str(target_idx)
    for kb in keyboards:
        name = kb.get("name", "")
        if name and is_typed_keyboard(name):
            subprocess.run(
                ["hyprctl", "switchxkblayout", name, target_str],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
    if 0 <= target_idx < len(configured_layouts):
        variant = variants[target_idx] if target_idx < len(variants) else ""
        sync_fcitx(configured_layouts[target_idx], variant)


COMMON_NAMES = {
    "us": "English",
    "en": "English",
    "ru": "Русский",
    "gr": "Ελληνικά",
    "el": "Ελληνικά",
    "ua": "Українська",
    "uk": "Українська",
    "by": "Беларуская",
    "de": "Deutsch",
    "fr": "Français",
    "es": "Español",
    "it": "Italiano",
    "pt": "Português",
    "pl": "Polski",
    "cz": "Čeština",
    "sk": "Slovenčina",
    "bg": "Български",
    "rs": "Српски",
    "tr": "Türkçe",
    "ja": "日本語",
    "zh": "中文",
    "ko": "한국어",
    "ar": "العربية",
    "he": "עברית",
}


def hud_names(configured_layouts, layouts_meta):
    """Bar aliases from settings win over the built-in language names."""
    names = []
    for idx, code in enumerate(configured_layouts):
        alias = ""
        if idx < len(layouts_meta):
            alias = str((layouts_meta[idx] or {}).get("alias") or "")
        names.append(alias or COMMON_NAMES.get(code.lower().strip(), code.upper()))
    return names


def show_switcher_hud(target_idx, configured_layouts, names):
    """Show card switcher HUD via Omarchy Shell IPC."""
    payload = json.dumps({
        "activeIndex": target_idx,
        "layouts": [c.upper() for c in configured_layouts],
        "names": names,
    })

    try:
        subprocess.Popen(
            ["omarchy-shell", "-q", "smyrnode.lingua", "showHud", payload],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


def load_state():
    try:
        with open(STATE_FILE, "r") as f:
            return json.load(f)
    except Exception:
        return None


def save_state(state):
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, STATE_FILE)


def main():
    settings = load_settings()
    configured_layouts = get_configured_layouts()
    num_layouts = len(configured_layouts)
    variants = get_configured_variants(num_layouts)

    if num_layouts < 2:
        # Nothing to switch between if there is only 1 layout
        return

    if settings.get("switchMode", "mru") != "mru":
        # Smart switching is off: plain sequential cycling on the same
        # hotkey (what XKB group toggling does), but through our switcher so
        # fcitx5 input methods stay in sync.
        devices = get_hyprland_devices()
        current_idx = get_active_layout_index(devices, num_layouts)
        apply_layout_to_typed(
            devices, (current_idx + 1) % num_layouts, configured_layouts, variants
        )
        return

    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    with open(LOCK_FILE, "w") as lock_file:
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        try:
            toggle(configured_layouts, variants, num_layouts, settings)
        finally:
            fcntl.flock(lock_file, fcntl.LOCK_UN)


def toggle(configured_layouts, variants, num_layouts, settings):
    devices = get_hyprland_devices()
    current_idx = get_active_layout_index(devices, num_layouts)
    now_ms = START_MS

    # Default state: [current, previous]
    default_prev = 1 if current_idx == 0 else 0
    mru = [current_idx, default_prev]
    origin = current_idx
    last_ts = 0

    saved = load_state()
    if saved:
        saved_mru = saved.get("mru", [])
        if (
            len(saved_mru) == 2
            and saved_mru[0] != saved_mru[1]
            and all(isinstance(x, int) and 0 <= x < num_layouts for x in saved_mru)
        ):
            mru = saved_mru
        origin = saved.get("origin", mru[0])
        last_ts = saved.get("last_ts", 0)

    # Resync MRU if active layout was changed externally
    if mru[0] != current_idx:
        mru = [current_idx, mru[0]]

    elapsed = now_ms - last_ts
    is_cycling = False

    if elapsed > CYCLE_TIMEOUT_MS or modifier_repressed_since(last_ts):
        # NORMAL TAP: Swap current and previous (MRU toggle)
        origin = mru[0]
        mru = [mru[1], mru[0]]
        is_cycling = False
    else:
        # CYCLING: Rapid press within timeout -> cycle through remaining layouts
        is_cycling = True
        next_layout = (mru[0] + 1) % num_layouts
        last_current = mru[0]
        if next_layout != origin:
            mru = [next_layout, origin]
        else:
            mru = [next_layout, last_current]

    # Safety guarantee: mru[0] and mru[1] are never identical
    if mru[0] == mru[1]:
        mru[1] = (mru[0] + 1) % num_layouts

    target = mru[0]

    save_state({
        "mru": mru,
        "origin": origin,
        "last_ts": now_ms,
    })

    # Switch typing keyboards
    apply_layout_to_typed(devices, target, configured_layouts, variants)

    # Show switcher HUD only when cycling through layouts (3+ layouts), never on normal toggle
    if num_layouts > 2 and is_cycling:
        meta = settings.get("layouts")
        meta = meta if isinstance(meta, list) else []
        show_switcher_hud(target, configured_layouts, hud_names(configured_layouts, meta))


if __name__ == "__main__":
    main()
